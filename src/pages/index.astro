<html lang="sl">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Besede AI</title>
	</head>
	<body>
		<div class="app" id="app" data-state="empty">
			<header class="header">
				<span class="title">Besede AI</span>
				<button type="button" id="reset-btn" class="reset-btn" hidden>Nov pogovor</button>
			</header>

			<main class="main">
				<div class="hero" id="hero">
					<h1>Besede AI</h1>
				</div>

				<div class="thread" id="thread" aria-live="polite"></div>

				<form class="composer" id="composer">
					<textarea
						id="question"
						class="question"
						placeholder="Npr. kako se sklanja beseda glodalec?"
						rows="1"
						required
					></textarea>
					<button type="submit" id="send-btn" class="send-btn" aria-label="Pošlji vprašanje">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
							<path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
				</form>
			</main>
		</div>

		<script>
			import { marked } from 'marked';
			import DOMPurify from 'dompurify';

			const app = document.getElementById('app') as HTMLDivElement;
			const thread = document.getElementById('thread') as HTMLDivElement;
			const composer = document.getElementById('composer') as HTMLFormElement;
			const textarea = document.getElementById('question') as HTMLTextAreaElement;
			const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
			const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;

			let conversationId: string | undefined;
			let isStreaming = false;

			function autoResize() {
				textarea.style.height = 'auto';
				textarea.style.height = `${Math.min(textarea.scrollHeight, 200)}px`;
			}
			textarea.addEventListener('input', autoResize);

			textarea.addEventListener('keydown', (event) => {
				if (event.key === 'Enter' && !event.shiftKey) {
					event.preventDefault();
					composer.requestSubmit();
				}
			});

			function enterChatState() {
				app.dataset.state = 'chat';
			}

			function addUserBubble(text: string) {
				const el = document.createElement('div');
				el.className = 'message user';
				el.textContent = text;
				thread.appendChild(el);
				thread.scrollTop = thread.scrollHeight;
			}

			function addAssistantBubble() {
				const el = document.createElement('div');
				el.className = 'message assistant pending';
				el.innerHTML = '<span class="dots"><span></span><span></span><span></span></span>';
				thread.appendChild(el);
				thread.scrollTop = thread.scrollHeight;
				return el;
			}

			function renderMarkdown(el: HTMLDivElement, markdown: string) {
				const html = marked.parse(markdown, { async: false }) as string;
				el.innerHTML = DOMPurify.sanitize(html);
				el.style.whiteSpace = 'normal';
			}

			async function sendQuestion(question: string) {
				isStreaming = true;
				sendBtn.disabled = true;
				addUserBubble(question);
				const bubble = addAssistantBubble();

				let appended = '';
				try {
					const res = await fetch('/api/chat', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ question, conversation_id: conversationId }),
					});

					const contentType = res.headers.get('content-type') ?? '';
					if (!res.ok || !contentType.includes('text/event-stream') || !res.body) {
						const data = await res.json().catch(() => null);
						bubble.classList.remove('pending');
						bubble.classList.add('error');
						bubble.textContent = data?.response ?? 'Prišlo je do napake. Poskusite znova.';
						return;
					}

					const reader = res.body.getReader();
					const decoder = new TextDecoder();
					let buffer = '';

					while (true) {
						const { value, done: readerDone } = await reader.read();
						if (readerDone) break;
						buffer += decoder.decode(value, { stream: true });

						const events = buffer.split('\n\n');
						buffer = events.pop() ?? '';

						for (const rawEvent of events) {
							const dataLine = rawEvent.split('\n').find((line) => line.startsWith('data:'));
							if (!dataLine) continue;

							let payload: { type: string; text?: string; response?: string; conversation_id?: string };
							try {
								payload = JSON.parse(dataLine.slice(5).trim());
							} catch {
								continue;
							}

							if (payload.type === 'delta') {
								appended += payload.text ?? '';
								bubble.classList.remove('pending');
								bubble.textContent = appended;
								thread.scrollTop = thread.scrollHeight;
							} else if (payload.type === 'done') {
								bubble.classList.remove('pending');
								renderMarkdown(bubble, payload.response ?? appended);
								conversationId = payload.conversation_id ?? conversationId;
								resetBtn.hidden = false;
							} else if (payload.type === 'error') {
								bubble.classList.remove('pending');
								bubble.classList.add('error');
								bubble.textContent = payload.response ?? 'Prišlo je do napake.';
							}
						}
					}
				} catch {
					bubble.classList.remove('pending');
					bubble.classList.add('error');
					bubble.textContent = 'Povezava je spodletela. Poskusite znova.';
				} finally {
					isStreaming = false;
					sendBtn.disabled = false;
				}
			}

			composer.addEventListener('submit', (event) => {
				event.preventDefault();
				if (isStreaming) return;
				const question = textarea.value.trim();
				if (!question) return;
				enterChatState();
				textarea.value = '';
				autoResize();
				sendQuestion(question);
			});

			resetBtn.addEventListener('click', async () => {
				if (conversationId) {
					try {
						await fetch('/api/reset', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ conversation_id: conversationId }),
						});
					} catch {
						// Best-effort: clear the local thread even if the reset call fails.
					}
				}
				conversationId = undefined;
				thread.innerHTML = '';
				resetBtn.hidden = true;
				app.dataset.state = 'empty';
				textarea.focus();
			});
		</script>

		<style is:global>
			:root {
				color-scheme: light;
				--bg: #ffffff;
				--fg: #1f1f1f;
				--muted: #5f6368;
				--border: #e3e3e3;
				--accent: #1a73e8;
				--bubble-user: #f0f4f9;
				--bubble-assistant: #ffffff;
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				height: 100%;
			}

			body {
				margin: 0;
				font-family:
					'Google Sans',
					-apple-system,
					BlinkMacSystemFont,
					'Segoe UI',
					Roboto,
					Arial,
					sans-serif;
				background: var(--bg);
				color: var(--fg);
			}

			.app {
				display: flex;
				flex-direction: column;
				height: 100vh;
			}

			.header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 1rem 1.5rem;
				flex-shrink: 0;
			}

			.title {
				font-size: 1.1rem;
				font-weight: 600;
				letter-spacing: 0.01em;
			}

			.reset-btn {
				border: 1px solid var(--border);
				background: transparent;
				color: var(--muted);
				border-radius: 999px;
				padding: 0.4rem 1rem;
				font-size: 0.85rem;
				cursor: pointer;
			}

			.reset-btn:hover {
				background: #f5f5f5;
			}

			.main {
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 1.5rem;
				overflow: hidden;
				width: 100%;
				max-width: 720px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}

			.hero {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
			}

			.hero h1 {
				font-size: clamp(1.8rem, 4vw, 2.6rem);
				font-weight: 500;
				margin: 0;
			}

			.thread {
				flex: 1;
				display: none;
				flex-direction: column;
				gap: 1rem;
				overflow-y: auto;
				padding: 1.5rem 0;
			}

			.message {
				white-space: pre-wrap;
				line-height: 1.5;
				font-size: 0.98rem;
			}

			.message.user {
				align-self: flex-end;
				background: var(--bubble-user);
				border-radius: 1.2rem;
				padding: 0.7rem 1.1rem;
				max-width: 80%;
			}

			.message.assistant {
				align-self: flex-start;
				background: var(--bubble-assistant);
				padding: 0.2rem 0;
				max-width: 100%;
			}

			.message.assistant.error {
				color: #c5221f;
			}

			.message.assistant p {
				margin: 0 0 0.75em;
			}

			.message.assistant p:last-child {
				margin-bottom: 0;
			}

			.message.assistant ul,
			.message.assistant ol {
				margin: 0 0 0.75em;
				padding-left: 1.4em;
			}

			.message.assistant li {
				margin-bottom: 0.25em;
			}

			.message.assistant code {
				background: #f1f3f4;
				padding: 0.15em 0.4em;
				border-radius: 4px;
				font-size: 0.9em;
				font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
			}

			.message.assistant pre {
				background: #f1f3f4;
				padding: 0.8em 1em;
				border-radius: 8px;
				overflow-x: auto;
				margin: 0 0 0.75em;
			}

			.message.assistant pre code {
				background: none;
				padding: 0;
			}

			.message.assistant a {
				color: var(--accent);
			}

			.message.assistant blockquote {
				margin: 0 0 0.75em;
				padding-left: 1em;
				border-left: 3px solid var(--border);
				color: var(--muted);
			}

			.dots {
				display: inline-flex;
				gap: 0.3rem;
				padding: 0.5rem 0;
			}

			.dots span {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--muted);
				animation: blink 1.2s infinite ease-in-out;
			}

			.dots span:nth-child(2) {
				animation-delay: 0.2s;
			}

			.dots span:nth-child(3) {
				animation-delay: 0.4s;
			}

			@keyframes blink {
				0%,
				80%,
				100% {
					opacity: 0.25;
				}
				40% {
					opacity: 1;
				}
			}

			.composer {
				flex-shrink: 0;
				width: 100%;
				padding-bottom: 1.5rem;
				display: flex;
				align-items: flex-end;
				gap: 0.5rem;
			}

			.question {
				flex: 1;
				resize: none;
				border: 1px solid var(--border);
				border-radius: 1.5rem;
				padding: 0.85rem 1.2rem;
				font-size: 1rem;
				font-family: inherit;
				max-height: 200px;
				box-shadow: 0 1px 6px rgba(32, 33, 36, 0.12);
			}

			.question:focus {
				outline: none;
				border-color: var(--accent);
			}

			.send-btn {
				flex-shrink: 0;
				width: 44px;
				height: 44px;
				border-radius: 50%;
				border: none;
				background: var(--accent);
				color: white;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
			}

			.send-btn:disabled {
				background: #c4c7c5;
				cursor: default;
			}

			.app[data-state='chat'] .hero {
				display: none;
			}

			.app[data-state='chat'] .thread {
				display: flex;
			}
		</style>
	</body>
</html>
